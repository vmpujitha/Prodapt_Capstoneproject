# LLM Providers Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

DEFAULT_LLM_PROVIDER=ollama
DEFAULT_EMBEDDING_PROVIDER=ollama

# Storage & Paths
CHROMA_DIR=./data/chroma
DATA_CSV_PATH=./data/raw/crop_yield.csv
# Folder holding the three Kaggle files (crop_yield.csv, state_soil_data.csv, state_weather_data_*.csv)
KAGGLE_SOURCE_DIR=./data_set
PROCESSED_DATA_PATH=./data/processed/cases.parquet
THRESHOLDS_PATH=./data/processed/thresholds.json
BM25_INDEX_DIR=./data/processed
MODELS_DIR=./models
FEEDBACK_DB_PATH=./data/feedback.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Retrieval & Ranking Parameters
HYBRID_ALPHA=0.5
RANKING_W1=0.35
RANKING_W2=0.25
RANKING_W3=0.20
RANKING_W4=0.10
RANKING_W5=0.10

# Judge Model Configuration (leave blank to judge with the chat model selected in the UI)
JUDGE_PROVIDER=
JUDGE_MODEL=

# Optional: Kaggle API credentials for automatic dataset download
KAGGLE_USERNAME=
KAGGLE_KEY=

# Guardrails & evaluation
RATE_LIMIT_PER_MINUTE=60
EVAL_TIMEOUT_SECONDS=180
EVAL_MAX_RETRIES=2
